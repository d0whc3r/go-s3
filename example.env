# S3-compatible endpoint and credentials
ENDPOINT=https://s3.eu-central-1.amazonaws.com
ACCESS_KEY=your-access-key
SECRET_KEY=your-secret-key
BUCKET=your-bucket-name
REGION=eu-central-1

# Optional S3 settings
MAX_RETRIES=3
FORCE_PATH_STYLE=true
SSL_ENABLED=true
DEBUG=false

# MySQL / MariaDB (--mysql or --db mysql / --db mariadb)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=app

# PostgreSQL (--postgres or --db postgres)
# POSTGRES_URL=postgres://postgres:secret@localhost:5432/app?sslmode=disable
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=secret
# POSTGRES_DATABASE=app
# POSTGRES_SSLMODE=prefer
# POSTGRES_SCHEMA=public

# SQLite (--sqlite /path/to/app.db or --db sqlite)
# SQLITE_PATH=/var/lib/app/data.db

# MongoDB (--mongodb or --db mongodb)
# MONGO_URI=mongodb://user:secret@localhost:27017
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_USER=root
# MONGO_PASSWORD=secret
# MONGO_DATABASE=app
